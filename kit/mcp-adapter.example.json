{
  "mcpServers": {
    "playwright": {
      "command": "npx",
      "args": [
        "@playwright/mcp@latest"
      ],
      "env": {}
    },
    "graphite-mcp": {
      "command": "node",
      "args": [
        "<YOUR-BUILD-PATH>/graphite-mcp/dist/src/index.js"
      ],
      "env": {}
    }
  },
  "settings": {
    "toolPrefix": "none"
  },
  "_notes": {
    "graphite-mcp": "Optional self-built adapter; remove this entry if you do not use it."
  }
}
